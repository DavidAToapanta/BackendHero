{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gym-api",
  "sourceRoot": "apps/gym-api/src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "tsc",
    "tsConfigPath": "apps/gym-api/tsconfig.app.json"
  },
  "projects": {
    "gym-api": {
      "type": "application",
      "root": "apps/gym-api",
      "entryFile": "main",
      "sourceRoot": "apps/gym-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gym-api/tsconfig.app.json"
      }
    },
    "permisos": {
      "type": "library",
      "root": "libs/permisos",
      "entryFile": "index",
      "sourceRoot": "libs/permisos/src",
      "compilerOptions": {
        "tsConfigPath": "libs/permisos/tsconfig.lib.json",
        "deleteOutDir": false
      }
    },
    "negocios": {
      "type": "library",
      "root": "libs/negocios",
      "entryFile": "index",
      "sourceRoot": "libs/negocios/src",
      "compilerOptions": {
        "tsConfigPath": "libs/negocios/tsconfig.lib.json",
        "deleteOutDir": false
      }
    },
    "identidad": {
      "type": "library",
      "root": "libs/identidad",
      "entryFile": "index",
      "sourceRoot": "libs/identidad/src",
      "compilerOptions": {
        "tsConfigPath": "libs/identidad/tsconfig.lib.json",
        "deleteOutDir": false
      }
    },
    "seguridad": {
      "type": "library",
      "root": "libs/seguridad",
      "entryFile": "index",
      "sourceRoot": "libs/seguridad/src",
      "compilerOptions": {
        "tsConfigPath": "libs/seguridad/tsconfig.lib.json",
        "deleteOutDir": false
      }
    },
    "inventario": {
      "type": "library",
      "root": "libs/inventario",
      "entryFile": "index",
      "sourceRoot": "libs/inventario/src",
      "compilerOptions": {
        "tsConfigPath": "libs/inventario/tsconfig.lib.json",
        "deleteOutDir": false
      }
    },
    "catalogo": {
      "type": "library",
      "root": "libs/catalogo",
      "entryFile": "index",
      "sourceRoot": "libs/catalogo/src",
      "compilerOptions": {
        "tsConfigPath": "libs/catalogo/tsconfig.lib.json",
        "deleteOutDir": false
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json",
        "deleteOutDir": false
      }
    }
  }
}
