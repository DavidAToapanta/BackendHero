// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              Int      @id @default(autoincrement())
  email           String?  @unique
  userName        String?  @unique
  password        String
  nombres         String
  apellidos       String
  cedula          String   @unique
  fechaNacimiento String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships                       UserTenant[]
  staffProfiles                     StaffProfile[]
  administrador                     Administrador[]
  entrenador                        Entrenador[]
  recepcionista                     Recepcionista[]
  cliente                           Cliente[]
  gastos                            Gasto[]
  devolucionMovimientos             DevolucionMovimiento[]
  vinculacionClienteUsuario_usuario VinculacionClienteUsuario[] @relation("VinculacionClienteUsuario_usuario")
  auditoriaOperacion_usuario        AuditoriaOperacion[]        @relation("AuditoriaOperacion_usuario")
  solicitudIdempotente_usuario      SolicitudIdempotente[]      @relation("SolicitudIdempotente_usuario")
}

model Tenant {
  id          Int          @id @default(autoincrement())
  nombre      String
  slug        String       @unique
  tipoNegocio TipoNegocio
  estado      TenantEstado @default(ACTIVO)
  saasPlan    SaasPlan     @default(FREE)

  email         String?
  telefono      String?
  direccion     String?
  ciudad        String?
  pais          String?
  logoUrl       String?
  descripcion   String?
  bridgeKeyHash String?

  latitud   Float?
  longitud  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                     UserTenant[]
  staffProfiles             StaffProfile[]
  modules                   TenantModule[]
  clientes                  Cliente[]
  clienteMedidas            ClienteMedida[]
  novedades                 Novedad[]
  productos                 Producto[]
  compras                   Compra[]
  planes                    Plan[]
  clientesPlan              ClientePlan[]
  pagos                     Pago[]
  deudas                    Deuda[]
  facturas                  Factura[]
  gastos                    Gasto[]
  ingresosRapidos           IngresoRapido[]
  asistencias               Asistencia[]
  rutinas                   Rutina[]
  entrenamientos            Entrenamiento[]
  semanas                   Semana[]
  musculosSemana            MusculoSemana[]
  ejerciciosMusculo         EjercicioMusculo[]
  cambiosPlan               CambioPlan[]
  devolucionMovimientos     DevolucionMovimiento[]
  zonaHoraria               String                      @default("America/Guayaquil")
  moneda                    String                      @default("USD") @db.Char(3)
  autorizacionVersion       VersionAutorizacion         @default(LEGACY)
  clienteComercial          ClienteComercial[]          @relation("ClienteComercial_tenant")
  vinculacionClienteUsuario VinculacionClienteUsuario[] @relation("VinculacionClienteUsuario_tenant")
  rolNegocio                RolNegocio[]                @relation("RolNegocio_tenant")
  rolPermiso                RolPermiso[]                @relation("RolPermiso_tenant")
  asignacionRol             AsignacionRol[]             @relation("AsignacionRol_tenant")
  categoriaProducto         CategoriaProducto[]         @relation("CategoriaProducto_tenant")
  productoImagen            ProductoImagen[]            @relation("ProductoImagen_tenant")
  entradaInventario         EntradaInventario[]         @relation("EntradaInventario_tenant")
  loteInventario            LoteInventario[]            @relation("LoteInventario_tenant")
  movimientoInventario      MovimientoInventario[]      @relation("MovimientoInventario_tenant")
  carrito                   Carrito[]                   @relation("Carrito_tenant")
  detalleCarrito            DetalleCarrito[]            @relation("DetalleCarrito_tenant")
  pedido                    Pedido[]                    @relation("Pedido_tenant")
  detallePedido             DetallePedido[]             @relation("DetallePedido_tenant")
  reservaInventario         ReservaInventario[]         @relation("ReservaInventario_tenant")
  historialEstadoPedido     HistorialEstadoPedido[]     @relation("HistorialEstadoPedido_tenant")
  venta                     Venta[]                     @relation("Venta_tenant")
  detalleVenta              DetalleVenta[]              @relation("DetalleVenta_tenant")
  asignacionLoteVenta       AsignacionLoteVenta[]       @relation("AsignacionLoteVenta_tenant")
  cobro                     Cobro[]                     @relation("Cobro_tenant")
  aplicacionCobro           AplicacionCobro[]           @relation("AplicacionCobro_tenant")
  reversionAplicacionCobro  ReversionAplicacionCobro[]  @relation("ReversionAplicacionCobro_tenant")
  cuentaPorCobrar           CuentaPorCobrar[]           @relation("CuentaPorCobrar_tenant")
  ajusteCuentaPorCobrar     AjusteCuentaPorCobrar[]     @relation("AjusteCuentaPorCobrar_tenant")
  reembolso                 Reembolso[]                 @relation("Reembolso_tenant")
  devolucionVenta           DevolucionVenta[]           @relation("DevolucionVenta_tenant")
  detalleDevolucionVenta    DetalleDevolucionVenta[]    @relation("DetalleDevolucionVenta_tenant")
  caja                      Caja[]                      @relation("Caja_tenant")
  turnoCaja                 TurnoCaja[]                 @relation("TurnoCaja_tenant")
  movimientoCaja            MovimientoCaja[]            @relation("MovimientoCaja_tenant")
  gastoComercial            GastoComercial[]            @relation("GastoComercial_tenant")
  secuenciaComprobante      SecuenciaComprobante[]      @relation("SecuenciaComprobante_tenant")
  comprobanteVenta          ComprobanteVenta[]          @relation("ComprobanteVenta_tenant")
  detalleComprobanteVenta   DetalleComprobanteVenta[]   @relation("DetalleComprobanteVenta_tenant")
  eventoSalida              EventoSalida[]              @relation("EventoSalida_tenant")
  notificacionCliente       NotificacionCliente[]       @relation("NotificacionCliente_tenant")
  auditoriaOperacion        AuditoriaOperacion[]        @relation("AuditoriaOperacion_tenant")
  solicitudIdempotente      SolicitudIdempotente[]      @relation("SolicitudIdempotente_tenant")

  @@index([tipoNegocio])
  @@index([estado])
}

model UserTenant {
  id        Int              @id @default(autoincrement())
  usuarioId Int
  tenantId  Int
  role      TenantRole
  estado    UserTenantEstado @default(ACTIVO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario                                Usuario                     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tenant                                 Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versionAutorizacion                    Int                         @default(1)
  vinculacionClienteUsuario_verificador  VinculacionClienteUsuario[] @relation("VinculacionClienteUsuario_verificador")
  asignacionRol_membresia                AsignacionRol[]             @relation("AsignacionRol_membresia")
  asignacionRol_asignador                AsignacionRol[]             @relation("AsignacionRol_asignador")
  entradaInventario_responsable          EntradaInventario[]         @relation("EntradaInventario_responsable")
  movimientoInventario_responsable       MovimientoInventario[]      @relation("MovimientoInventario_responsable")
  historialEstadoPedido_responsable      HistorialEstadoPedido[]     @relation("HistorialEstadoPedido_responsable")
  venta_responsable                      Venta[]                     @relation("Venta_responsable")
  venta_anuladaPor                       Venta[]                     @relation("Venta_anuladaPor")
  cobro_responsable                      Cobro[]                     @relation("Cobro_responsable")
  cobro_reversadoPor                     Cobro[]                     @relation("Cobro_reversadoPor")
  aplicacionCobro_responsable            AplicacionCobro[]           @relation("AplicacionCobro_responsable")
  reversionAplicacionCobro_responsable   ReversionAplicacionCobro[]  @relation("ReversionAplicacionCobro_responsable")
  ajusteCuentaPorCobrar_responsable      AjusteCuentaPorCobrar[]     @relation("AjusteCuentaPorCobrar_responsable")
  reembolso_responsable                  Reembolso[]                 @relation("Reembolso_responsable")
  devolucionVenta_responsable            DevolucionVenta[]           @relation("DevolucionVenta_responsable")
  devolucionVenta_aprobadaPor            DevolucionVenta[]           @relation("DevolucionVenta_aprobadaPor")
  turnoCaja_cajero                       TurnoCaja[]                 @relation("TurnoCaja_cajero")
  turnoCaja_cerradoPor                   TurnoCaja[]                 @relation("TurnoCaja_cerradoPor")
  movimientoCaja_responsable             MovimientoCaja[]            @relation("MovimientoCaja_responsable")
  gastoComercial_responsable             GastoComercial[]            @relation("GastoComercial_responsable")
  comprobanteVenta_emitidoPor            ComprobanteVenta[]          @relation("ComprobanteVenta_emitidoPor")
  comprobanteVenta_anuladoPor            ComprobanteVenta[]          @relation("ComprobanteVenta_anuladoPor")
  auditoriaOperacion_membresia           AuditoriaOperacion[]        @relation("AuditoriaOperacion_membresia")
  auditoriaOperacion_membresiaReferencia AuditoriaOperacion[]        @relation("AuditoriaOperacion_membresiaReferencia")

  @@unique([usuarioId, tenantId])
  @@unique([tenantId, id])
  @@unique([tenantId, id, usuarioId])
  @@index([tenantId, role])
  @@index([usuarioId])
}

model TenantModule {
  id       Int       @id @default(autoincrement())
  tenantId Int
  module   ModuleKey
  activo   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId])
}

model Administrador {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model Entrenador {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  horario   String
  sueldo    Float
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model Recepcionista {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  horario   String
  sueldo    Float
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model StaffProfile {
  id         Int        @id @default(autoincrement())
  usuarioId  Int
  tenantId   Int
  tenantRole TenantRole
  horario    String
  sueldo     Float
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tenantId, tenantRole])
  @@index([tenantId])
  @@index([usuarioId])
  @@index([tenantId, tenantRole])
}

model Cliente {
  id             Int     @id @default(autoincrement())
  usuarioId      Int
  tenantId       Int
  horario        String
  sexo           String
  observaciones  String
  objetivos      String
  tiempoEntrenar Int
  activo         Boolean @default(true)
  zkbioPersonId  String?

  usuario                     Usuario            @relation(fields: [usuarioId], references: [id])
  tenant                      Tenant             @relation(fields: [tenantId], references: [id])
  clienteMedidas              ClienteMedida[]
  novedades                   Novedad[]
  compras                     Compra[]
  planes                      ClientePlan[]
  rutinas                     Rutina[]
  asistencias                 Asistencia[]
  cambiosPlan                 CambioPlan[]
  clienteComercial_clienteGym ClienteComercial[] @relation("ClienteComercial_clienteGym")

  @@unique([usuarioId, tenantId])
  @@unique([tenantId, zkbioPersonId])
  @@unique([tenantId, id])
  @@index([usuarioId])
  @@index([tenantId])
}

model Medida {
  id             Int             @id @default(autoincrement())
  nombre         String
  clienteMedidas ClienteMedida[]
}

model ClienteMedida {
  id        Int @id @default(autoincrement())
  tenantId  Int
  clienteId Int
  medidaId  Int
  medida    Int

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  cliente    Cliente @relation(fields: [clienteId], references: [id])
  medidaTipo Medida  @relation(fields: [medidaId], references: [id])

  @@index([tenantId])
}

model Novedad {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  clienteId  Int
  novedad    String
  fecha      DateTime
  solventada Boolean

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([tenantId])
}

model Producto {
  id       Int     @id @default(autoincrement())
  tenantId Int
  nombre   String
  precio   Decimal @db.Decimal(18, 2)
  stock    Int
  estado   Boolean

  tenant                        Tenant                 @relation(fields: [tenantId], references: [id])
  compras                       Compra[]
  sku                           String?
  codigoBarras                  String?
  marca                         String?
  presentacion                  String?
  descripcion                   String?
  unidadVenta                   UnidadVenta            @default(UNIDAD)
  stockReservado                Int                    @default(0)
  modoInventario                ModoInventario         @default(LEGACY)
  createdAt                     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime               @updatedAt @db.Timestamptz(3)
  categoriaId                   Int?
  productoImagen_producto       ProductoImagen[]       @relation("ProductoImagen_producto")
  loteInventario_producto       LoteInventario[]       @relation("LoteInventario_producto")
  movimientoInventario_producto MovimientoInventario[] @relation("MovimientoInventario_producto")
  detalleCarrito_producto       DetalleCarrito[]       @relation("DetalleCarrito_producto")
  detallePedido_producto        DetallePedido[]        @relation("DetallePedido_producto")
  reservaInventario_producto    ReservaInventario[]    @relation("ReservaInventario_producto")
  detalleVenta_producto         DetalleVenta[]         @relation("DetalleVenta_producto")
  auditoriaOperacion_producto   AuditoriaOperacion[]   @relation("AuditoriaOperacion_producto")
  categoria                     CategoriaProducto?     @relation("Producto_categoria", fields: [tenantId, categoriaId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, codigoBarras])
  @@index([tenantId])
  @@index([tenantId, estado, categoriaId])
}

model Compra {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  productoId Int
  clienteId  Int
  cantidad   Int
  total      Float
  fecha      DateTime

  tenant                            Tenant                 @relation(fields: [tenantId], references: [id])
  producto                          Producto               @relation(fields: [productoId], references: [id])
  cliente                           Cliente                @relation(fields: [clienteId], references: [id])
  movimientoInventario_compraLegacy MovimientoInventario[] @relation("MovimientoInventario_compraLegacy")

  @@unique([tenantId, id, productoId])
  @@index([tenantId])
}

model Plan {
  id             Int            @id @default(autoincrement())
  tenantId       Int
  nombre         String
  precio         Float
  duracion       Int
  unidadDuracion UnidadDuracion @default(MESES)
  activo         Boolean        @default(true)
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  clientePlan    ClientePlan[]

  @@index([tenantId])
}

model ClientePlan {
  id          Int               @id @default(autoincrement())
  tenantId    Int
  clienteId   Int
  planId      Int
  fechaInicio DateTime
  fechaFin    DateTime
  diaPago     Int
  activado    Boolean
  estado      EstadoClientePlan @default(ACTIVO)

  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  cliente             Cliente      @relation(fields: [clienteId], references: [id])
  plan                Plan         @relation(fields: [planId], references: [id])
  pago                Pago[]
  deudas              Deuda[]
  facturas            Factura[]
  cambiosComoAnterior CambioPlan[] @relation("PlanAnterior")
  cambiosComoNuevo    CambioPlan[] @relation("PlanNuevo")

  @@index([tenantId])
}

model Pago {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  clientePlanId Int
  monto         Float
  fecha         DateTime

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  clientePlan ClientePlan @relation(fields: [clientePlanId], references: [id])

  @@index([tenantId])
  @@index([clientePlanId])
  @@index([fecha])
}

model Deuda {
  id            Int     @id @default(autoincrement())
  tenantId      Int
  clientePlanId Int
  monto         Float
  solventada    Boolean

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  clientePlan ClientePlan @relation(fields: [clientePlanId], references: [id])

  @@index([tenantId])
}

model Rutina {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  clienteId   Int
  rutina      Bytes
  fechaInicio DateTime
  fechaFin    DateTime
  observacion String

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  entrenamiento Entrenamiento? @relation("RutinaEntrenamiento") // sin fields ni references

  @@index([tenantId])
}

model Entrenamiento {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  rutinaId   Int     @unique
  finalizado Boolean

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  rutina  Rutina   @relation("RutinaEntrenamiento", fields: [rutinaId], references: [id])
  semanas Semana[]

  @@index([tenantId])
}

model Semana {
  id              Int             @id @default(autoincrement())
  tenantId        Int
  numero          Int
  entrenamientoId Int
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  entrenamiento   Entrenamiento   @relation(fields: [entrenamientoId], references: [id])
  musculosSemana  MusculoSemana[]

  @@index([tenantId])
}

model MusculoSemana {
  id        Int @id @default(autoincrement())
  tenantId  Int
  semanaId  Int
  musculoId Int
  orden     Int // Orden en que se entrena este músculo en la semana

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  semana            Semana             @relation(fields: [semanaId], references: [id])
  musculo           Musculo            @relation(fields: [musculoId], references: [id])
  ejerciciosMusculo EjercicioMusculo[]

  @@index([tenantId])
}

model Musculo {
  id             Int             @id @default(autoincrement())
  nombre         String          @unique
  musculosSemana MusculoSemana[]
}

model EjercicioMusculo {
  id              Int @id @default(autoincrement())
  tenantId        Int
  musculoSemanaId Int
  ejercicioId     Int
  orden           Int // Orden en que se hace este ejercicio para el músculo

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  musculoSemana MusculoSemana @relation(fields: [musculoSemanaId], references: [id])
  ejercicio     Ejercicio     @relation(fields: [ejercicioId], references: [id])
  seriesReps    SerieRep[]
  seriesTiempos SerieTiempo[]

  @@index([tenantId])
}

model Ejercicio {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  foto   Bytes? // Keeping foto from HEAD just in case

  ejerciciosMusculo EjercicioMusculo[]
}

model SerieRep {
  id                 Int    @id @default(autoincrement())
  ejercicioMusculoId Int
  orden              Int
  peso               Float
  repeticiones       Int
  unidadMedida       String

  ejercicioMusculo EjercicioMusculo @relation(fields: [ejercicioMusculoId], references: [id])
}

model SerieTiempo {
  id                 Int    @id @default(autoincrement())
  ejercicioMusculoId Int
  orden              Int
  peso               Float
  tiempo             Int
  unidadMedida       String

  ejercicioMusculo EjercicioMusculo @relation(fields: [ejercicioMusculoId], references: [id])
}

model Gasto {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  descripcion String
  monto       Float
  fecha       DateTime @default(now())
  usuarioId   Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([tenantId])
}

model IngresoRapido {
  id       Int      @id @default(autoincrement())
  tenantId Int
  concepto String
  monto    Float
  fecha    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([fecha])
}

model Asistencia {
  id                 Int              @id @default(autoincrement())
  tenantId           Int
  clienteId          Int
  fecha              DateTime         @default(now())
  horaEntrada        DateTime         @default(now())
  origen             OrigenAsistencia @default(MANUAL)
  eventoBiometricoId String?
  dispositivoSn      String?
  biometricoPersonId String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, fecha(sort: Desc)]) // Solo 1 asistencia por día
  @@unique([tenantId, eventoBiometricoId])
  @@index([tenantId])
  @@index([clienteId, fecha])
}

model Factura {
  id            Int    @id @default(autoincrement())
  numero        String @unique
  tenantId      Int
  clientePlanId Int

  subtotal Float
  iva      Float
  total    Float

  totalPagado     Float @default(0)
  creditoAplicado Float @default(0)
  saldo           Float

  estado       EstadoFactura
  fechaEmision DateTime      @default(now())

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  clientePlan  ClientePlan            @relation(fields: [clientePlanId], references: [id])
  devoluciones DevolucionMovimiento[]

  @@index([tenantId])
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ANULADA
}

enum TipoNegocio {
  GYM
  STORE
  MIXTO
}

enum TenantEstado {
  ACTIVO
  SUSPENDIDO
  ELIMINADO
}

enum TenantRole {
  OWNER
  ADMIN
  EMPLEADO
  ENTRENADOR
  RECEPCIONISTA
  CAJERO
}

enum UserTenantEstado {
  ACTIVO
  PENDIENTE
  INACTIVO
}

enum ModuleKey {
  GYM
  STORE
}

enum SaasPlan {
  FREE
  PLUS
}

enum EstadoClientePlan {
  ACTIVO
  CAMBIADO
  FINALIZADO
  CANCELADO
}

enum UnidadDuracion {
  MESES
  DIAS
}

enum OrigenAsistencia {
  MANUAL
  BIOMETRIA
}

enum EstadoDevolucion {
  PENDIENTE
  PARCIAL
  COMPLETADO
  NO_APLICA
}

model CambioPlan {
  id                          Int              @id @default(autoincrement())
  tenantId                    Int
  clienteId                   Int
  clientePlanAnteriorId       Int
  clientePlanNuevoId          Int
  montoPagadoTransferido      Float
  montoDevuelto               Float            @default(0)
  devolucionPendiente         Float            @default(0)
  devolucionDevueltaAcumulada Float            @default(0)
  fecha                       DateTime         @default(now())
  estadoDevolucion            EstadoDevolucion @default(PENDIENTE)
  motivo                      String?

  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  cliente             Cliente                @relation(fields: [clienteId], references: [id])
  clientePlanAnterior ClientePlan            @relation("PlanAnterior", fields: [clientePlanAnteriorId], references: [id])
  clientePlanNuevo    ClientePlan            @relation("PlanNuevo", fields: [clientePlanNuevoId], references: [id])
  devoluciones        DevolucionMovimiento[]

  @@index([tenantId])
}

model DevolucionMovimiento {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  cambioPlanId Int
  facturaId    Int
  monto        Float
