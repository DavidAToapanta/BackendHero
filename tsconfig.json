{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "src/*": ["./apps/gym-api/src/*"],
      "@app/prisma": ["./libs/prisma/src"],
      "@app/identidad": ["./libs/identidad/src"],
      "@app/negocios": ["./libs/negocios/src"],
      "@app/permisos": ["./libs/permisos/src"],
      "@app/seguridad": ["./libs/seguridad/src"],
      "@app/catalogo": ["./libs/catalogo/src"],
      "@app/inventario": ["./libs/inventario/src"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
